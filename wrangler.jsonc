{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qicau",
  "main": "worker.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
